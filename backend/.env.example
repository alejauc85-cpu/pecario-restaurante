# Railway inyecta esta variable automáticamente al agregar el plugin de PostgreSQL.
# En local, apunta a tu propia base Postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/brasa

# Cambia esto por un valor largo y aleatorio en producción.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

PORT=4000

# Dominio(s) permitido(s) para CORS, separados por coma. Usa el dominio de tu
# frontend en Railway/Vercel/etc. "*" solo para pruebas locales.
CORS_ORIGIN=http://localhost:3000
